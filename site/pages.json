{
  "baseURL": "https://ledohy.github.io/MyWebPage/",
  "enableGitInfo": false,
  "themesDir": "themes",
  "timeout": "120s",
  "security": {
    "exec": {
      "allow": [
        "^(dart-)?sass$",
        "^go$",
        "^git$",
        "^node$",
        "^postcss$",
        "^tailwindcss$",
        "^asciidoctor$"
      ]
    },
    "allowContent": [
      "^text/"
    ]
  },
  "theme": [
    "template"
  ],
  "title": "이동현 | 포트폴리오",
  "locale": "ko-KR",
  "params": {
    "profileMode": {
      "enabled": true,
      "title": "이동현",
      "subtitle": "CS @ JBNU · Computer Vision"
    }
  },
  "menus": {
    "main": [
      {
        "identifier": "about",
        "name": "소개",
        "pageRef": "/about",
        "weight": 10
      },
      {
        "identifier": "activities",
        "name": "활동",
        "pageRef": "/activities",
        "weight": 20
      }
    ]
  }
}
